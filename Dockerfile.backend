
# ---------- Runtime stage ----------
FROM node:22-alpine

WORKDIR /usr/src/app

# Upgrade Alpine packages to receive security fixes
RUN apk upgrade --no-cache

COPY --from=builder --chown=node:node /usr/src/app ./

# Remove npm and its bundled vulnerable dependencies
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx

USER node

EXPOSE 5001

CMD ["node", "server.js"]

